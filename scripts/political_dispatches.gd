static func _case(id: String, source: String, title: String, body: String, left: Array, right: Array, role := "official") -> Dictionary:
	return {
		"id": id,
		"source": source,
		"role": role,
		"accent": "#536f82" if role == "military" else "#8b6c4b",
		"title": title,
		"body": body,
		"left": _choice(left),
		"right": _choice(right),
	}


static func _choice(parts: Array) -> Dictionary:
	var choice := {"label": parts[0], "hint": parts[1], "effects": parts[2], "result": parts[3]}
	if parts.size() > 4:
		choice["set"] = parts[4]
	return choice
